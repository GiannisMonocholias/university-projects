library ieee;
use ieee.std_logic_1164.all;

ENTITY and2 IS
PORT (in1,in2 : IN STD_LOGIC;
		output_and2    : OUT STD_LOGIC);
END and2;

ARCHITECTURE model_and2 OF and2 IS 
BEGIN
 output_and2 <= in1 AND in2;
END model_and2;


library ieee;
use ieee.std_logic_1164.all;

ENTITY and3 IS 
PORT (in1,in2,in3: IN STD_LOGIC;
		output_and3 : OUT STD_LOGIC);
END and3;

ARCHITECTURE model_and3 OF and3 IS 
BEGIN 
	output_and3 <= in1 AND in2 AND in3;
END model_and3;

library ieee;
use ieee.std_logic_1164.all;

ENTITY and4 IS 
PORT (in1,in2,in3,in4:IN STD_LOGIC;
		output_and4    :	OUT STD_LOGIC);
END and4;
		
